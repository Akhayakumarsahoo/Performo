{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "lib": ["es2020"],
    "outDir": "../dist",
    "rootDir": "..",
    "noEmit": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../app/schemas/**/*.ts"]
}
